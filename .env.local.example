# ============================================================
# SahakariSIP — Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your Supabase project values.
# Get these from: https://supabase.com/dashboard → Settings → API

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# NextAuth Configuration
AUTH_SECRET=

# Google OAuth Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Email Settings (for Magic Links)
# If using Gmail, HOST is smtp.gmail.com and PORT is 587
EMAIL_SERVER_HOST=
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASSWORD=
EMAIL_FROM=
